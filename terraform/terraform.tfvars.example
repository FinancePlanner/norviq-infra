# Copy to terraform.tfvars (gitignored). The hcloud token is better kept as an
# HCP workspace variable or TF_VAR_hcloud_token in your shell.

ssh_public_key = "ssh-ed25519 AAAA... you@machine"
admin_cidrs    = ["203.0.113.7/32"] # your IP — SSH + kube-api
# server_name  = "norviq-green"
# server_type  = "cx22"
# location     = "fsn1"

# Reusable Tailscale auth key so the node joins the tailnet on first boot
# (needed to reach the hermes VPS). Generate in the Tailscale admin console.
tailscale_authkey = ""
